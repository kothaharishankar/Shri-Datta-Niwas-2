# Copy this file to `.env` and fill in what you have.
# Anything left blank degrades gracefully — the site tells visitors honestly
# what is still being added rather than breaking.

# Formspree form ID (the bit after https://formspree.io/f/). Leave blank to
# send enquiries through WhatsApp instead.
VITE_FORMSPREE_ID=

# WhatsApp number in international format, digits only. Example: 919876543210
VITE_WHATSAPP_NUMBER=

# Canonical production URL, no trailing slash. Used for SEO and OG metadata.
# Leave blank until the final production domain is known.
VITE_SITE_URL=

# Optional analytics (off by default — the site is cookie-free without it).
# VITE_PLAUSIBLE_DOMAIN=
# VITE_GA_MEASUREMENT_ID=
